# Copiá este archivo a un lugar local (NO lo commits con secretos).
# Definí estas variables de entorno de Windows/Usuario antes de abrir Cursor,
# o cargalas en tu perfil de PowerShell ($PROFILE).

# --- GitHub MCP ---
# Crear PAT en https://github.com/settings/tokens
# Scopes mínimos sugeridos: repo, read:org, workflow (si usás Actions)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SQL Server MCP (BD local ElOlvidado) ---
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ElOlvidado
MSSQL_USER=sa
MSSQL_PASSWORD=TU_PASSWORD_AQUI
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
